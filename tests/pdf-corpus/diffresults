#!/usr/bin/env bash
set -u

cd "$(dirname "$0")" || exit 1
shopt -s nullglob

verbose=0
if [[ "${1:-}" == "-v" ]]; then
    verbose=1
    shift
fi

failed=0

for expected_file in *.expected.*; do
    actual_file="${expected_file/.expected./.}"

    if [[ ! -f "$actual_file" ]]; then
        echo "Missing output: $actual_file"
        failed=1
        continue
    fi

    if [[ "$verbose" -eq 1 ]]; then
        if ! diff -U 1 "$expected_file" "$actual_file"; then
            failed=1
        fi
    elif ! diff -q "$expected_file" "$actual_file" >/dev/null; then
        echo "Mismatch: $expected_file differs from $actual_file"
        failed=1
    fi
done

if [[ "$failed" -eq 0 ]]; then
    echo "All checks passed"
fi

exit "$failed"
